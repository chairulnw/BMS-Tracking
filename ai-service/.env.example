BACKEND_URL=http://localhost:8002
SECRET_KEY=changeme-must-match-backend/.env-exactly
CORS_ORIGINS=http://localhost:4200
DETECTOR_MODEL=yolo26n.pt     # yolo26n.pt | yolo11n.pt | rtdetr-l.pt
REID_MODEL=transreid          # transreid | osnet_ain_x1_0 | bot_resnet50
TRACKER_TYPE=bytetrack        # bytetrack | botsort | ocsort
ENABLE_LATENCY_LOG= 1         # 1 | 0
CLIP_BBOX_OVERLAY=0           # 1 | 0 — gambar bbox + label di klip rekaman