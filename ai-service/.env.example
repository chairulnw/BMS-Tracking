BACKEND_URL=http://localhost:8002
SECRET_KEY=changeme-must-match-backend/.env-exactly
CORS_ORIGINS=http://localhost:4200

# Pemilihan komponen pipeline — dibaca sebagai konstanta modul saat proses
# start (main.py + batch_processor.py), ganti butuh restart penuh, bukan
# cuma /stream/stop + /stream/start. Lihat ai-service/pipeline-comparison.md
# buat perbandingan kombinasi.
DETECTOR_MODEL=checkpoints/yolo26n.pt   # path .pt Ultralytics (checkpoints/yolo26n.pt, checkpoints/yolo11n.pt, checkpoints/rtdetr-l.pt, ...)
REID_MODEL=transreid          # transreid | bot_resnet50 | osnet_ain_x1_0 | resnet50 (checkpoint resnet50 rusak/degenerate, lihat pipeline-comparison.md — pakai bot_resnet50)
TRACKER_TYPE=bytetrack        # bytetrack | botsort | ocsort
